{
  "profile": "pay",
  "version": "0.1",
  "extends": "RW1",
  "description": "Accounts-payable runs: invoice extraction, reconciliation against POs and the bank feed, payment scheduling, audit, and escalation to the principal. Escalations use the closed answer vocabulary ans: AQ opts and AN val come from it.",
  "enums": {
    "cur": {
      "GBP": "pounds sterling",
      "USD": "US dollars",
      "EUR": "euros"
    },
    "kind": {
      "NET": "net of VAT",
      "GROSS": "including VAT"
    },
    "dec": {
      "PAY": "schedule for payment this run",
      "HOLD": "keep on the run but do not pay yet",
      "EXCL": "exclude from the run"
    },
    "flag": {
      "OVERLIM": "above approval threshold",
      "FX": "not in run currency",
      "BANKCHG": "bank-detail change requested",
      "LOOKALIKE": "sender domain differs from master",
      "DUP": "same invoice received twice",
      "CORR": "corrected version issued",
      "VOID": "voided by supplier",
      "PAID": "already paid per bank feed",
      "CN": "credit note",
      "REFUNDED": "credit already refunded",
      "POVAR": "differs from PO",
      "NOPO": "no PO found",
      "STMT": "statement, not an invoice",
      "NOISE": "not a supplier document"
    },
    "appr": {
      "REQ": "approval required",
      "OK": "approved by the principal",
      "NO": "declined by the principal",
      "NA": "no approval needed"
    },
    "ans": {
      "APPROVE": "yes, proceed as asked",
      "DECLINE": "no, do not proceed",
      "HOLD": "keep it on the run, do not pay in this run",
      "REJECT": "refuse the request; nothing changes",
      "CALLBACK": "verify with the supplier by phone on the number on file before anything changes"
    }
  },
  "asks": {
    "RECON": "match extracted invoices to POs and the bank feed; decide pay, hold or exclude per policy",
    "SCHED": "build the payment run from the payable list per policy",
    "AUDIT": "check the payment run against policy and sources; sign off or send back",
    "PAY": "release one payment exactly as instructed: item, amount, currency, payee account, payment date, reference",
    "CHGBANK": "change one supplier's payment details in the master to the details given, under the approval reference given",
    "SEND": "send one email to the supplier address given with the figures given; nothing else"
  },
  "slots": [
    {
      "key": "sup",
      "type": "token",
      "desc": "supplier short name, lowercase, no spaces",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN",
        "DN",
        "UN",
        "FL"
      ],
      "required": false
    },
    {
      "key": "po",
      "type": "token",
      "desc": "purchase order id",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN"
      ],
      "required": false
    },
    {
      "key": "amt",
      "type": "money",
      "desc": "amount, two decimals, no thousands separator",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN",
        "DN"
      ],
      "required": false
    },
    {
      "key": "cur",
      "type": "enum:cur",
      "desc": "currency of amt",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN",
        "DN"
      ],
      "required": false
    },
    {
      "key": "kind",
      "type": "enum:kind",
      "desc": "whether amt is NET or GROSS",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN",
        "DN"
      ],
      "required": false
    },
    {
      "key": "dec",
      "type": "enum:dec",
      "desc": "decision for the item",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN",
        "DN"
      ],
      "required": false
    },
    {
      "key": "flag",
      "type": "list:enum:flag",
      "desc": "why the item needs attention; several allowed",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN",
        "DN",
        "UN"
      ],
      "required": false
    },
    {
      "key": "appr",
      "type": "enum:appr",
      "desc": "approval state",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN",
        "DN"
      ],
      "required": false
    },
    {
      "key": "var",
      "type": "money",
      "desc": "variance against the PO, net, signed",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN"
      ],
      "required": false
    },
    {
      "key": "n",
      "type": "int:0-9999",
      "desc": "count of items",
      "on": [
        "HO",
        "RB",
        "ST",
        "DN"
      ],
      "required": false
    },
    {
      "key": "tot",
      "type": "money",
      "desc": "total of PAY lines in the run currency",
      "on": [
        "ST",
        "DN"
      ],
      "required": false
    },
    {
      "key": "src",
      "type": "list:token",
      "desc": "where the fact came from: email:<n> (message number in the inbox export), bank:<YYYYMMDD>, po:<id>; several allowed",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN",
        "DN"
      ],
      "required": false
    },
    {
      "key": "net",
      "type": "money",
      "desc": "net amount before VAT",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN"
      ],
      "required": false
    },
    {
      "key": "vat",
      "type": "money",
      "desc": "VAT amount; net + vat = amt when kind=GROSS",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN"
      ],
      "required": false
    },
    {
      "key": "acct",
      "type": "token",
      "desc": "payee account as sortcode/number, e.g. 40-12-88/61102938",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN",
        "DN"
      ],
      "required": false
    },
    {
      "key": "paid",
      "type": "date",
      "desc": "payment date",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN",
        "DN"
      ],
      "required": false
    },
    {
      "key": "ref",
      "type": "token",
      "desc": "payment or remittance reference as the supplier will see it",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN",
        "DN"
      ],
      "required": false
    },
    {
      "key": "eff",
      "type": "date",
      "desc": "date a change takes effect",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN",
        "DN"
      ],
      "required": false
    },
    {
      "key": "apref",
      "type": "token",
      "desc": "the principal's approval reference for an irreversible act, e.g. FD-0926",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN",
        "DN"
      ],
      "required": false
    },
    {
      "key": "addr",
      "type": "token",
      "desc": "email address, for SEND",
      "on": [
        "HO",
        "RB",
        "ST",
        "AQ",
        "AN",
        "DN"
      ],
      "required": false
    },
    {
      "key": "prev",
      "type": "token",
      "on": [
        "RB",
        "DN"
      ],
      "required": false,
      "desc": "the account on file that a bank change replaces, as sortcode/number"
    }
  ],
  "agents": [
    "extractor",
    "reconciler",
    "scheduler",
    "auditor",
    "payer",
    "coordinator",
    "desk"
  ],
  "item_namespace": "inv",
  "item_examples": [
    "inv:INV-000491",
    "inv:7731",
    "sup:northfield",
    "run:2026-09"
  ],
  "asks_used": [
    "EXTRACT",
    "REVIEW",
    "FIX",
    "RECON",
    "SCHED",
    "AUDIT",
    "PAY",
    "CHGBANK",
    "SEND"
  ],
  "translation": {
    "note": "When lines are the artefact: every ST about a source document carries src=; an invoice line carries amt cur kind; if net and vat are given with kind=GROSS then net + vat must equal amt (checked in code). Before an irreversible act (PAY, CHGBANK, SEND) the HO is built from the approval record by code or checked against it before it is sent, asks rb=exec, and the RB and the DN carry the execution slots listed under exec."
  },
  "exec": {
    "PAY": [
      "sup",
      "amt",
      "cur",
      "kind",
      "acct",
      "paid",
      "ref",
      "apref"
    ],
    "CHGBANK": [
      "sup",
      "acct",
      "eff",
      "apref",
      "prev"
    ],
    "SEND": [
      "sup",
      "addr",
      "amt",
      "cur",
      "paid",
      "ref"
    ]
  }
}
